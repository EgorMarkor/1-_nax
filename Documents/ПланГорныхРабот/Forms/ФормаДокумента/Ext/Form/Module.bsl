&НаКлиенте
Процедура РаботыВидРаботПриИзменении(Элемент)
    
    // Получаем текущую строку
    ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Получаем выбранный вид работ
    ВидРабот = ТекущаяСтрока.ВидРабот;
    Если ЗначениеЗаполнено(ВидРабот) Тогда
        // Получаем данные вида работ с сервера
        ДанныеВидаРабот = ПолучитьДанныеВидаРабот(ВидРабот);
        Если ДанныеВидаРабот <> Неопределено Тогда
            // Заполняем единицу измерения и номенклатуру
            ТекущаяСтрока.ЕдиницаИзмерения = ДанныеВидаРабот.ЕдиницаИзмеренияПродукции;
            ТекущаяСтрока.Номенклатура = ДанныеВидаРабот.ВыпускаемаяПродукция;
        КонецЕсли;
    КонецЕсли;
    
КонецПроцедуры

&НаКлиенте
Процедура РаботыНоменклатураПриИзменении(Элемент)
    
    // Получаем текущую строку
    ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Получаем выбранную номенклатуру
    Номенклатура = ТекущаяСтрока.Номенклатура;
    Если ЗначениеЗаполнено(Номенклатура) Тогда
        // Получаем данные номенклатуры с сервера
        ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(Номенклатура);
        Если ДанныеНоменклатуры <> Неопределено Тогда
            // Заполняем единицу измерения
            ТекущаяСтрока.ЕдиницаИзмерения = ДанныеНоменклатуры.ЕдиницаИзмерения;
        КонецЕсли;
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеВидаРабот(СсылкаВидаРабот)
    
    Если Не ЗначениеЗаполнено(СсылкаВидаРабот) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    // Запрашиваем данные вида работ из базы
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    ВидыРабот.Ссылка,
        |    ВидыРабот.ВыпускаемаяПродукция,
        |    ВидыРабот.ЕдиницаИзмеренияПродукции
        |ИЗ
        |    Справочник.ВидыРабот КАК ВидыРабот
        |ГДЕ
        |    ВидыРабот.Ссылка = &Ссылка";
    
    Запрос.УстановитьПараметр("Ссылка", СсылкаВидаРабот);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        // Возвращаем структуру с данными
        Данные = Новый Структура;
        Данные.Вставить("ВыпускаемаяПродукция", Выборка.ВыпускаемаяПродукция);
        Данные.Вставить("ЕдиницаИзмеренияПродукции", Выборка.ЕдиницаИзмеренияПродукции);
        Возврат Данные;
    КонецЕсли;
    
    Возврат Неопределено;
    
КонецФункции

&НаСервере
Функция ПолучитьДанныеНоменклатуры(СсылкаНоменклатуры)
    
    Если Не ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    // Запрашиваем данные номенклатуры из базы
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Номенклатура.Ссылка,
        |    Номенклатура.ЕдиницаИзмерения
        |ИЗ
        |    Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
        |    Номенклатура.Ссылка = &Ссылка";
    
    Запрос.УстановитьПараметр("Ссылка", СсылкаНоменклатуры);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        // Возвращаем структуру с данными
        Данные = Новый Структура;
        Данные.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
        Возврат Данные;
    КонецЕсли;
    
    Возврат Неопределено;
    
КонецФункции