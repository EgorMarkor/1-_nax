&НаКлиенте
Процедура ПланПриИзменении(Элемент)
    // Очищаем табличную часть перед заполнением
    Объект.Работы.Очистить();
    
    План = Объект.План;
    Если Не ЗначениеЗаполнено(План) Тогда
        Возврат;
    КонецЕсли;
    
    // Получаем данные плана с сервера
    ДанныеПлана = ПолучитьДанныеПлана(План);
    Если ДанныеПлана = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Заполняем табличную часть данными из плана
    Для Каждого СтрокаПлана Из ДанныеПлана Цикл
        НоваяСтрока = Объект.Работы.Добавить();
        НоваяСтрока.ВидРабот = СтрокаПлана.ВидРабот;
        НоваяСтрока.Номенклатура = СтрокаПлана.Номенклатура;
        НоваяСтрока.ЕдиницаИзмерения = СтрокаПлана.ЕдиницаИзмерения;
        // Можно добавить планируемое количество, например, сумму по всем дням
        НоваяСтрока.ПланируемоеКоличество = СтрокаПлана.СуммаПлана;
        
        // Заполняем оборудование из вида работ (через сервер)
        Если ЗначениеЗаполнено(НоваяСтрока.ВидРабот) Тогда
            Оборудование = ПолучитьОборудованиеИзВидаРабот(НоваяСтрока.ВидРабот);
            Если Оборудование <> Неопределено Тогда
                НоваяСтрока.Оборудование = Оборудование;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры  

&НаСервере
Функция ПолучитьДанныеПлана(СсылкаПлан)
    
    Если Не ЗначениеЗаполнено(СсылкаПлан) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    // Запрашиваем данные плана
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    ПланГорныхРаботРаботы.ВидРабот,
    |    ПланГорныхРаботРаботы.Номенклатура,
    |    ПланГорныхРаботРаботы.ЕдиницаИзмерения,
    |    ПланГорныхРаботРаботы.Понедельник + 
    |    ПланГорныхРаботРаботы.Вторник +
    |    ПланГорныхРаботРаботы.Среда +
    |    ПланГорныхРаботРаботы.Четверг +
    |    ПланГорныхРаботРаботы.Пятница +
    |    ПланГорныхРаботРаботы.Суббота +
    |    ПланГорныхРаботРаботы.Воскресенье КАК СуммаПлана
    |ИЗ
    |    Документ.ПланГорныхРабот.Работы КАК ПланГорныхРаботРаботы
    |ГДЕ
    |    ПланГорныхРаботРаботы.Ссылка = &СсылкаПлана";
    
    Запрос.УстановитьПараметр("СсылкаПлана", СсылкаПлан);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    МассивДанных = Новый Массив;
    
    Пока Выборка.Следующий() Цикл
        // Создаем структуру для каждой строки
        СтрокаДанных = Новый Структура;
        СтрокаДанных.Вставить("ВидРабот", Выборка.ВидРабот);
        СтрокаДанных.Вставить("Номенклатура", Выборка.Номенклатура);
        СтрокаДанных.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
        СтрокаДанных.Вставить("СуммаПлана", Выборка.СуммаПлана);
        
        МассивДанных.Добавить(СтрокаДанных);
    КонецЦикла;
    
    Возврат МассивДанных;
    
КонецФункции

&НаСервере
Функция ПолучитьОборудованиеИзВидаРабот(СсылкаВидаРабот)
    
    Если Не ЗначениеЗаполнено(СсылкаВидаРабот) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    // Запрашиваем оборудование из вида работ
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |    ВидыРаботИспользуемоеОборудование.Оборудование
    |ИЗ
    |    Справочник.ВидыРабот.ИспользуемоеОборудование КАК ВидыРаботИспользуемоеОборудование
    |ГДЕ
    |    ВидыРаботИспользуемоеОборудование.Ссылка = &СсылкаВидаРабот";
    
    Запрос.УстановитьПараметр("СсылкаВидаРабот", СсылкаВидаРабот);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        Возврат Выборка.Оборудование;
    КонецЕсли;
    
    Возврат Неопределено;
    
КонецФункции