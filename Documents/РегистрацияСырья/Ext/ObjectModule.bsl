&НаСервере
Процедура ПередЗаписью(Отказ)
    
    // Проверяем заполненность обязательных полей
    Если Не ЗначениеЗаполнено(УникальныйНомерПартии) Тогда
        Отказ = Истина;
        Сообщить("Не заполнен уникальный номер партии!");
        Возврат;
    КонецЕсли;
    
    // Проверяем уникальность номера партии
    Если Не ЭтотОбъект.ЭтоНовый() Тогда
        // При изменении получаем старые данные из базы
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |    РегистрацияСырья.УникальныйНомерПартии
            |ИЗ
            |    Документ.РегистрацияСырья КАК РегистрацияСырья
            |ГДЕ
            |    РегистрацияСырья.Ссылка = &Ссылка";
        
        Запрос.УстановитьПараметр("Ссылка", Ссылка);
        
        Результат = Запрос.Выполнить();
        Выборка = Результат.Выбрать();
        
        Если Выборка.Следующий() Тогда
            СтарыйНомерПартии = Выборка.УникальныйНомерПартии;
            Если СтарыйНомерПартии = УникальныйНомерПартии Тогда
                Возврат; // Номер не менялся, проверка не нужна
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    
    // Проверяем существование такого номера в базе
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    РегистрацияСырья.Ссылка
        |ИЗ
        |    Документ.РегистрацияСырья КАК РегистрацияСырья
        |ГДЕ
        |    РегистрацияСырья.УникальныйНомерПартии = &НомерПартии";
    
    Запрос.УстановитьПараметр("НомерПартии", УникальныйНомерПартии);
    
    Результат = Запрос.Выполнить();
    Если Результат.Пустой() Тогда
        Возврат; // Номера нет, все OK
    КонецЕсли;
    
    // Если нашли запись и это не текущий документ
    Выборка = Результат.Выбрать();
    Если Выборка.Следующий() Тогда
        Если ЭтотОбъект.ЭтоНовый() Или Выборка.Ссылка <> Ссылка Тогда
            Отказ = Истина;
            Сообщить("Номер партии " + УникальныйНомерПартии + " уже существует!");
        КонецЕсли;
    КонецЕсли;
    
КонецПроцедуры