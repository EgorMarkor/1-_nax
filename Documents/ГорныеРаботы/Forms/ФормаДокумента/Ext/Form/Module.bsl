&НаКлиенте
// Обработчик изменения номенклатуры в строке таблицы
Процедура РаботыНоменклатураПриИзменении(Элемент)
    
    // Получаем текущую строку
    ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
    Если ТекущаяСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Получаем выбранную номенклатуру
    Номенклатура = ТекущаяСтрока.Номенклатура;
    Если ЗначениеЗаполнено(Номенклатура) Тогда
        // Получаем данные номенклатуры
        ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(Номенклатура);
        Если ДанныеНоменклатуры <> Неопределено Тогда
            // Заполняем единицу измерения
            ТекущаяСтрока.ЕдиницаИзмерения = ДанныеНоменклатуры.ЕдиницаИзмерения;
        КонецЕсли;
    КонецЕсли;
    
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеНоменклатуры(СсылкаНоменклатуры)
    
    Если Не ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    // Запрашиваем данные номенклатуры из базы
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Номенклатура.Ссылка,
        |    Номенклатура.ЕдиницаИзмерения
        |ИЗ
        |    Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
        |    Номенклатура.Ссылка = &Ссылка";
    
    Запрос.УстановитьПараметр("Ссылка", СсылкаНоменклатуры);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        // Возвращаем структуру с данными
        Данные = Новый Структура;
        Данные.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
        Возврат Данные;
    КонецЕсли;
    
    Возврат Неопределено;
    
КонецФункции