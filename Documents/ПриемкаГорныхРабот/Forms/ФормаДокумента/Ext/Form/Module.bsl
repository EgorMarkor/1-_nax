
&НаКлиенте
Процедура ГорныеРаботыПриИзменении(Элемент)
	// Очищаем табличную часть перед заполнением
    Объект.Работы.Очистить();
    
    СсылкаГорныеРаботы = Объект.ГорныеРаботы;
    Если Не ЗначениеЗаполнено(СсылкаГорныеРаботы) Тогда
        Возврат;
    КонецЕсли;
    
    // Получаем данные горных работ с сервера
    ДанныеГорныхРабот = ПолучитьДанныеГорныхРабот(СсылкаГорныеРаботы);
    Если ДанныеГорныхРабот = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Заполняем табличную часть данными из горных работ
    Для Каждого СтрокаГорныхРабот Из ДанныеГорныхРабот Цикл
        НоваяСтрока = Объект.Работы.Добавить();
        НоваяСтрока.ВремяНачала = СтрокаГорныхРабот.ВремяНачала;
        НоваяСтрока.Оборудование = СтрокаГорныхРабот.Оборудование;
        НоваяСтрока.Номенклатура = СтрокаГорныхРабот.Номенклатура;
        НоваяСтрока.ЕдиницаИзмерения = СтрокаГорныхРабот.ЕдиницаИзмерения;
        // Поле "Норма по плану" из горных работ не переносим, 
        // так как в приемке должно быть "Фактически выполнено"
        // Оставляем его пустым для заполнения пользователем
    КонецЦикла;
КонецПроцедуры     

&НаСервере
Функция ПолучитьДанныеГорныхРабот(СсылкаГорныеРаботы)
    
    Если Не ЗначениеЗаполнено(СсылкаГорныеРаботы) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    // Запрашиваем данные горных работ
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |    ГорныеРаботыРаботы.ВремяНачала,
    |    ГорныеРаботыРаботы.Оборудование,
    |    ГорныеРаботыРаботы.Номенклатура,
    |    ГорныеРаботыРаботы.ЕдиницаИзмерения
    |ИЗ
    |    Документ.ГорныеРаботы.Работы КАК ГорныеРаботыРаботы
    |ГДЕ
    |    ГорныеРаботыРаботы.Ссылка = &СсылкаГорныхРабот";
    
    Запрос.УстановитьПараметр("СсылкаГорныхРабот", СсылкаГорныеРаботы);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    МассивДанных = Новый Массив;
    
    Пока Выборка.Следующий() Цикл
        // Создаем структуру для каждой строки
        СтрокаДанных = Новый Структура;
        СтрокаДанных.Вставить("ВремяНачала", Выборка.ВремяНачала);
        СтрокаДанных.Вставить("Оборудование", Выборка.Оборудование);
        СтрокаДанных.Вставить("Номенклатура", Выборка.Номенклатура);
        СтрокаДанных.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
        
        МассивДанных.Добавить(СтрокаДанных);
    КонецЦикла;
    
    Возврат МассивДанных;
    
КонецФункции
