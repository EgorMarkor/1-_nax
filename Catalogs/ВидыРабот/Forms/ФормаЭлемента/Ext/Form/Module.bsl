
&НаКлиенте
Процедура ВыпускаемаяПродукцияПриИзменении(Элемент)
	// Получаем выбранную номенклатуру
    ВыбраннаяНоменклатура = Объект.ВыпускаемаяПродукция;
    
    // Если номенклатура не выбрана - очищаем единицу измерения
    Если Не ЗначениеЗаполнено(ВыбраннаяНоменклатура) Тогда
        Объект.ЕдиницаИзмеренияПродукции = Неопределено;
        Возврат;
    КонецЕсли;
    
    // Получаем данные выбранной номенклатуры с сервера
    // (так как справочники хранятся на сервере)
    ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(ВыбраннаяНоменклатура);
    
    // Если получили данные - устанавливаем единицу измерения
    Если ДанныеНоменклатуры <> Неопределено Тогда
        Объект.ЕдиницаИзмеренияПродукции = ДанныеНоменклатуры.ЕдиницаИзмерения;
    КонецЕсли;
КонецПроцедуры    

&НаСервере
Функция ПолучитьДанныеНоменклатуры(СсылкаНоменклатуры)
    
    // Если ссылка пустая - возвращаем Неопределено
    Если Не ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда
        Возврат Неопределено;
    КонецЕсли;
    
    // Запрашиваем данные номенклатуры из базы
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |    Номенклатура.Ссылка,
        |    Номенклатура.ЕдиницаИзмерения
        |ИЗ
        |    Справочник.Номенклатура КАК Номенклатура
        |ГДЕ
        |    Номенклатура.Ссылка = &Ссылка";
    
    Запрос.УстановитьПараметр("Ссылка", СсылкаНоменклатуры);
    
    Результат = Запрос.Выполнить();
    Выборка = Результат.Выбрать();
    
    Если Выборка.Следующий() Тогда
        // Возвращаем структуру с данными
        Данные = Новый Структура;
        Данные.Вставить("ЕдиницаИзмерения", Выборка.ЕдиницаИзмерения);
        Возврат Данные;
    КонецЕсли;
    
    Возврат Неопределено;
    
КонецФункции
