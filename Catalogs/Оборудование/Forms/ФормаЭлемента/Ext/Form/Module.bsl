
&НаКлиенте
Процедура ГаражныйНомерПриИзменении(Элемент)
	СформироватьНаименование();
КонецПроцедуры    

&НаКлиенте
Процедура МодельПриИзменении(Элемент)
	СформироватьНаименование();
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНаименование()
    
    // Получаем текущие значения полей
    ГаражныйНомерТекст = Объект.ГаражныйНомер;
    МодельТекст = Объект.Модель;
    
    // Если оба поля заполнены
    Если Не ЗначениеЗаполнено(ГаражныйНомерТекст) Или Не ЗначениеЗаполнено(МодельТекст) Тогда
        Возврат; // Не формируем, если что-то не заполнено
    КонецЕсли;
    
    // Формируем новое наименование
    НовоеНаименование = ГаражныйНомерТекст + " - " + МодельТекст;
    
    // Присваиваем полю "Наименование"
    Объект.Наименование = НовоеНаименование;
    
КонецПроцедуры

